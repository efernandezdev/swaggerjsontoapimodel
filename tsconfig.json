{
  "compilerOptions": {
    "types": ["node"],
    "target": "es2022",
    "strict": true,

    "esModuleInterop": true,

    "outDir": "./bin",
    "rootDir": "./src",
    "removeComments": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
